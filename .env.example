# LLM Configuration
# Supported values: openai, azure_openai
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL and LLM_* settings take precedence over the legacy OPENAI_* names.
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000
LLM_ASSESSMENT_MAX_TOKENS=6000
LLM_ASSESSMENT_REASONING_EFFORT=low
LLM_TEMPERATURE=0.3
# Optional override for custom Azure deployment names: true or false.
# LLM_SUPPORTS_REASONING=false

# Legacy OpenAI names remain supported for existing deployments.
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_ASSESSMENT_MAX_TOKENS=6000
OPENAI_ASSESSMENT_REASONING_EFFORT=low
OPENAI_TEMPERATURE=0.3

# Azure OpenAI (required only when LLM_PROVIDER=azure_openai)
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=your-model-deployment-name

# Optional Langfuse observability. Leave the keys empty for no telemetry.
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_TRACING_RELEASE=diagrammatic-api@1.0.0
# LANGFUSE_SAMPLE_RATE=1.0
# Keep prompt/completion content out of Langfuse by default.
# LANGFUSE_CAPTURE_CONTENT=false

# API Configuration
# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","https://diagramwise.com","https://www.diagramwise.com","https://diagrammatic.next-zen.dev"]

# Trusted Hosts Configuration (add your domain in production)
TRUSTED_HOSTS=["localhost","127.0.0.1","0.0.0.0","testserver","diagrammatic.next-zen.dev","diagramwise.com","www.diagramwise.com","your_domain.com"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
# Comma/JSON-list of reverse-proxy addresses only; do not add public client IPs.
TRUSTED_PROXY_IPS=[]

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-use-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Email verification (Resend)
# The sender domain remains on the existing verified domain until mail DNS is migrated.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Diagramwise <no-reply@diagrammatic.next-zen.dev>"
# Optional override. Must be a public HTTPS image URL for email clients.
BRAND_LOGO_URL=https://diagramwise.com/logo.png
# Use a separate random value in production; JWT_SECRET_KEY is used as a
# temporary fallback when this is omitted.
EMAIL_VERIFICATION_SECRET=replace-with-a-random-secret
EMAIL_VERIFICATION_EXPIRE_MINUTES=20
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
FRONTEND_URL=https://diagramwise.com
PUBLIC_API_URL=https://api.diagramwise.com
# Optional browser-rendered PNG previews. Leave unset to use the deterministic
# local preview fallback during renderer rollout.
DIAGRAMWISE_RENDERER_URL=
DIAGRAMWISE_RENDERER_TOKEN=

# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# AWS DynamoDB Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
DYNAMODB_USERS_TABLE=diagrammatic_users
DYNAMODB_DIAGRAMS_TABLE=diagrammatic_diagrams
DYNAMODB_PROBLEMS_TABLE=diagrammatic_problems
DYNAMODB_FEEDBACK_TABLE=diagrammatic_feedback
ANALYTICS_S3_BUCKET=diagrammatic
ANALYTICS_HMAC_SECRET=replace-with-a-random-analytics-secret
# Use rediss:// for a TLS-enabled Redis provider.
REDIS_URI=redis://default:replace-with-redis-password@localhost:6379/0
ANALYTICS_FLUSH_INTERVAL_SECONDS=60

# Whisper transcription service (whisper-service local dev / deployed API Gateway URL)
WHISPER_SERVICE_URL=http://localhost:8001
